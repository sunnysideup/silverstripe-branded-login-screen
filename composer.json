{
    "name": "sunnysideup/branded-login-screen",
    "description": "Provides you with the option to brand your login screen.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "login",
        "branding",
        "brand",
        "logo",
        "personalise",
        "log-in",
        "multi-factor",
        "various log-in options"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "silverstripe/framework": "^6.0",
        "silverstripe/admin": "^3.0"
    },
    "require-dev": {
        "sunnysideup/sswebpack_engine_only": "^5.0-dev",
        "silverleague/ideannotator": "*",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/standards": "^1",
        "phpstan/extension-installer": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Sunnysideup\\BrandedLoginScreen\\": "src/"
        }
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Nicolaas Thiemen Francken",
            "email": "modules@sunnysideup.co.nz",
            "role": "lead developer"
        }
    ],
    "yet-to-update": {
        "tractorcow/silverstripe-colorpicker": {
            "section": "require",
            "current": "^4.2",
            "reason": "no-compatible-stable-release"
        }
    }
}